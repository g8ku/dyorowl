# Solana RPC endpoint. The public endpoint works for a few lookups but is
# heavily rate-limited. For the bot, use a free key from a provider such as
# Helius, QuickNode or Triton and paste the full URL here.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How many pages (1,000 signatures each) to walk back when looking for the
# token's creator. Older or very busy tokens may need more; each page is one
# RPC call.
CREATOR_LOOKUP_MAX_PAGES=5

# ---- X bot (npm run bot) ----
# From developer.x.com: your app's "API Key and Secret" (consumer keys), and the
# "Access Token and Secret" generated for the @dyorowl account AFTER setting the
# app's permissions to Read and write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# The bot posts nothing until this is true. Run it in dry-run first.
BOT_LIVE=false

# Cost safeguards
BOT_DAILY_REPLY_CAP=50       # replies per UTC day, across everyone
BOT_PER_USER_DAILY_CAP=3     # replies per person per UTC day
BOT_CACHE_MINUTES=15         # reuse a coin's case file for this long
BOT_POLL_SECONDS=30          # how often to check mentions. Each check is an API read, and
                             # X limits how often you can read mentions on your plan; the bot
                             # waits out the limit if it hits it, but raise this if it keeps happening.

# true: replies keep everyone in the thread tagged (more views). false: only the
# person who asked is tagged. X's automation rules forbid unsolicited automated
# mentions, so set this to false if the account gets warned or limited.
BOT_TAG_THREAD=true

# Where the bot remembers what it already answered.
BOT_STATE_FILE=.bot-state.json
