# Solana RPC endpoint. The public endpoint works for a few lookups but is
# heavily rate-limited. For the bot, use a free key from a provider such as
# Helius, QuickNode or Triton and paste the full URL here.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How many pages (1,000 signatures each) to walk back when looking for the
# token's creator. Older or very busy tokens may need more; each page is one
# RPC call.
CREATOR_LOOKUP_MAX_PAGES=5
